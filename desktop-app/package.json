{
  "name": "neurosync-desktop",
  "version": "1.0.0",
  "description": "NeuroSync Desktop Agent",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare-python": "node scripts/setup-python-embed.js",
    "build": "node scripts/setup-python-embed.js && electron-builder"
  },
  "build": {
    "appId": "com.neurosync.desktop",
    "productName": "NeuroSync",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "asarUnpack": [
      "renderer/stats.py"
    ],
    "extraResources": [
      {
        "from": "../desktop-agent",
        "to": "desktop-agent",
        "filter": ["**/*", "!**/__pycache__/*", "!**/*.pyc", "!**/*.dylib", "!**/*.so"]
      },
      {
        "from": "python-embed",
        "to": "python",
        "filter": ["**/*", "!**/__pycache__/*", "!**/*.pyc", "!**/*.dylib", "!**/*.so"]
      }
    ],
    "mac": { "target": "dmg" },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  }
}